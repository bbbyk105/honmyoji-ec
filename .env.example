# microCMS — Blog（ブログ）の記事はここから来る。
# 両方そろって初めて CMS を読む。無いときは data/blog.ts の seed で動く。
MICROCMS_SERVICE_DOMAIN=your-service      # https://<これ>.microcms.io
MICROCMS_API_KEY=

# API（エンドポイント）名を blogs 以外にしたときだけ
# MICROCMS_BLOG_ENDPOINT=blogs

# Webhook（カスタム通知）の共通シークレット。/api/revalidate の署名検証に使う。
MICROCMS_WEBHOOK_SECRET=

# お問い合わせの通知先（無ければサーバログのみ）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OG 画像の metadataBase。本番ドメイン確定時に設定。
NEXT_PUBLIC_SITE_URL=
